# Variables para las pruebas E2E con Playwright.
# Copiar a .env.e2e (ignorado por git) y ajustar al ambiente.

# URL del frontend. Si se define, Playwright NO levanta `npm run dev`
# y prueba contra esta URL (p. ej. staging).
# BASE_URL=http://localhost:5173

# Usuario admin creado por el seed de GB-BE
E2E_ADMIN_EMAIL=admin@goldenbites.local
E2E_ADMIN_PASSWORD=ChangeMe123!
E2E_ADMIN_NAME=Admin Golden Bites

# Cuenta de plataforma del seed (en el POS está inactiva; usa la app Admin)
E2E_PLATFORM_ADMIN_EMAIL=superadmin@goldenbitespos.local
E2E_PLATFORM_ADMIN_PASSWORD=ChangeMe123!

# URL de la API (para preparar datos de prueba)
# E2E_API_URL=http://localhost:3000/api/v1

# Cajero de prueba (rol CASHIER). No viene en el seed: la suite lo crea
# por API la primera vez si no existe.
E2E_CASHIER_EMAIL=cajero.e2e@goldenbites.local
E2E_CASHIER_PASSWORD=CajeroE2E123!

# Cocinero de prueba (rol KITCHEN). También lo crea la suite por API.
E2E_KITCHEN_EMAIL=cocina.e2e@goldenbites.local
E2E_KITCHEN_PASSWORD=CocinaE2E123!

# Repartidor de prueba (rol COURIER). También lo crea la suite por API.
# Requiere el módulo Domicilios activo en el negocio.
E2E_COURIER_EMAIL=domiciliario.e2e@goldenbites.local
E2E_COURIER_PASSWORD=Domiciliario123!
