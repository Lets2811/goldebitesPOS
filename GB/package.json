{
  "name": "golden-bites-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "typecheck": "tsc -b --noEmit",
    "build:mesero": "tsc -b && vite build --mode mesero",
    "mesero:android": "npm run build:mesero && node scripts/cap-app.mjs mesero sync android",
    "mesero:open": "node scripts/cap-app.mjs mesero open android",
    "build:domiciliario": "tsc -b && vite build --mode domiciliario",
    "domiciliario:android": "npm run build:domiciliario && node scripts/cap-app.mjs domiciliario sync android",
    "domiciliario:open": "node scripts/cap-app.mjs domiciliario open android",
    "dev:mesero": "vite --mode mesero --port 5176 --strictPort",
    "dev:domiciliario": "vite --mode domiciliario --port 5177 --strictPort",
    "apk:mesero": "node scripts/build-apk.mjs mesero",
    "apk:mesero:local": "node scripts/build-apk.mjs mesero --local",
    "apk:domiciliario": "node scripts/build-apk.mjs domiciliario",
    "apk:domiciliario:local": "node scripts/build-apk.mjs domiciliario --local"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.3.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/push-notifications": "^8.1.3",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.4.0",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.18.1",
    "dayjs": "^1.11.21",
    "lottie-react": "^3.1.2",
    "lucide-react": "^1.26.0",
    "notistack": "^3.0.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-grid-layout": "^2.3.0",
    "react-hook-form": "^7.82.0",
    "react-router-dom": "^7.18.1",
    "react-swipeable": "^7.0.2",
    "recharts": "^3.10.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/google.maps": "^3.58.1",
    "@types/node": "^24.13.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.1"
  }
}
