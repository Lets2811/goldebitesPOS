# POS-ADMIN API (the Golden Bites team's Admin). Copy to .env.
PORT=3200
# Where the Admin app runs (comma-separated). In development, its Vite server.
CORS_ORIGIN=http://localhost:5175

# Signs this service's own sessions. Any long random string, never the POS's
# JWT secret: a POS session must never pass for an Admin one.
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRES_IN=15m
ADMIN_REFRESH_EXPIRES_IN=7d

# The POS's internal API (GB-BE) and the key it expects (its INTERNAL_API_KEY,
# at least 32 characters). Everything about businesses goes through it.
POS_INTERNAL_URL=http://localhost:3000/api/v1/internal
INTERNAL_API_KEY=

# The POS's database: only for the Admin's own tables (platform_users,
# platform_refresh_tokens). The tables come from GB-BE's migrations (088).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=false
