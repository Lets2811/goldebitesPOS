# POS-ADMIN app. Copy to .env (optional: every value has a default).

# POS-ADMIN's API. Relative on purpose: vite.config.ts (and nginx in a deploy)
# proxies it, so the browser always calls the same origin.
VITE_ADMIN_API_URL=/admin-api/v1

# "staging" shows a STAGING chip; leave empty for production and development.
VITE_APP_ENV=

# TURA's app, linked with a QR from a business's TURA panel.
VITE_TURA_APP_URL=http://localhost:5174
