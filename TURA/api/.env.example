# Application
PORT=3100
# Comma-separated list of allowed origins for the TURA client (TURA/app).
# Not needed in local dev: the app's Vite server proxies /tura to this service.
CORS_ORIGIN=http://localhost:5174

# Which Golden Bites API (GB-BE) this service talks to: "local" or "prod".
# Each address includes the API's global prefix. TURA never touches the POS
# database: every read goes through this API with the access token of the user
# who is talking, so permissions and tenancy are enforced by GB-BE.
# A token only works on the POS that issued it: local and prod sign theirs
# with different secrets.
POS_API_TARGET=local
POS_API_URL_LOCAL=http://localhost:3000/api/v1
POS_API_URL_PROD=
# How long one request to the POS may take, in milliseconds. Past it the tool
# reports the failure to the assistant, which tells the user.
POS_API_TIMEOUT_MS=15000

# Claude API key (https://platform.claude.com). Required for /tura/chat. It is
# read only by this service and never reaches the app.
ANTHROPIC_API_KEY=

# Development only: a POS access token used when a request brings none, so
# the assistant can be tried for real without linking the app first (every
# unlinked visitor then acts as that user). Generate one in GB-BE with
# "npm run dev:token -- <email>". Ignored when NODE_ENV=production.
TURA_DEV_POS_TOKEN=

# Key for the developer's usage and cost screen (/tura/admin, and #admin in the
# app). Any long random string; leave it empty to switch the admin API off.
TURA_ADMIN_KEY=

# Development switch: "true" makes TURA answer with canned replies and made-up
# figures instead of calling Claude, so working on the interface costs nothing.
# The rest (linking, streaming, voice) behaves the same.
TURA_SIMULATE_AI=false

# Model and reasoning effort (low | medium | high | xhigh | max). Lower effort
# answers faster, which matters once voice is on.
TURA_MODEL=claude-haiku-5-5
TURA_EFFORT=low
# Ceiling of one model response, in tokens. The model's thinking counts
# against it, so too low a value cuts answers short.
TURA_MAX_TOKENS=1024
# One request to Claude: timeout in milliseconds, and how many times it is
# retried (with a growing wait) on rate limits, server errors and dropped
# connections.
TURA_CLAUDE_TIMEOUT_MS=30000
TURA_CLAUDE_MAX_RETRIES=2
# How many of the user's latest messages (with the answers between them) the
# model sees, and how many model round-trips one message may take.
TURA_HISTORY_TURNS=10
TURA_MAX_TOOL_ITERATIONS=6

# Audit log: one line per message with who asked, the tools called, their
# parameters, the start of each result and any error. Defaults to
# data/audit.jsonl; it holds business data, so keep it out of version control.
# TURA_AUDIT_LOG=

# Timezone used to resolve "hoy", "ayer", etc. into date ranges.
TURA_TIMEZONE=America/Bogota
