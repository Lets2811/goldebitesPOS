{
  "name": "tura-api",
  "private": true,
  "version": "0.1.0",
  "description": "TURA — servicio del asistente. Habla con el POS solo a través de la API de GB-BE.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "eval:sales": "tsx src/evals/sales-phrases.eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
