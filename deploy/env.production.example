# Copy this file to `.env.production` at the repo root on the server and fill
# in real values. `.env.production` is already covered by the root
# `.gitignore` (`.env.*` pattern) — never commit it.
#
# Used by docker-compose.prod.yml both as the backend's env_file and (via
# `docker compose --env-file .env.production`) to fill in ${DB_NAME} etc. in
# the compose file itself.

# Application
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1
# The single public origin serving the frontend (same origin also proxies
# /api/ to the backend, see GB/nginx.conf), e.g. http://<server-public-ip>
CORS_ORIGIN=

# PostgreSQL (DB_HOST is set to "postgres" by docker-compose.prod.yml itself)
DB_PORT=5432
DB_NAME=golden_bites
DB_USER=golden_bites
# Generate with: openssl rand -base64 32
DB_PASSWORD=
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_SSL=false

# JWT — generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Fixed business/branch the public, unauthenticated Car Service kiosk
# endpoints operate on (see GB-BE/src/modules/tablet-kiosk). Find yours with:
# SELECT id FROM businesses; / SELECT id FROM branches;
CAR_SERVICE_BUSINESS_ID=
CAR_SERVICE_BRANCH_ID=

# "Rectificar caja" master key — generate with: openssl rand -base64 24
# Remember to run `npm run seed` after deploying so cash.reopen syncs to SUPER_ADMIN/OWNER.
CASH_SESSION_MASTER_KEY=

# Encrypts third-party credentials stored in the database (electronic invoicing,
# Factus). Long random value; never change it once credentials are saved, or
# they can no longer be read. Generate with: openssl rand -base64 48
CREDENTIALS_ENCRYPTION_KEY=
